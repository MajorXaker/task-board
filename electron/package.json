{
  "name": "task-board",
  "version": "0.1.0",
  "description": "TaskBoard — collaborative drag-and-drop task tracker",
  "main": "main.js",
  "author": "MajorXaker",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MajorXaker/task-board.git"
  },
  "scripts": {
    "start": "electron .",
    "build:linux":   "electron-builder --linux",
    "build:mac":     "electron-builder --mac",
    "build:win":     "electron-builder --win",
    "build:all":     "electron-builder --linux --mac --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.majorxaker.taskboard",
    "productName": "TaskBoard",
    "copyright": "Copyright © 2026 MajorXaker",

    "directories": {
      "output": "dist"
    },

    "files": [
      "main.js",
      "preload.js",
      "assets/**"
    ],

    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] },
        { "target": "deb",      "arch": ["x64", "arm64"] },
        { "target": "rpm",      "arch": ["x64"] }
      ],
      "category": "Utility"
    },

    "mac": {
      "target": [
        { "target": "dmg",  "arch": ["x64", "arm64"] },
        { "target": "zip",  "arch": ["x64", "arm64"] }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },

    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },

    "publish": {
      "provider": "github",
      "owner": "MajorXaker",
      "repo": "task-board",
      "releaseType": "release"
    }
  }
}

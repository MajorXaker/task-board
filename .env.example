# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=taskboard
DB_PASSWORD=taskboard
DB_NAME=taskboard

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Static files directory (contains index.html)
STATIC_DIR=./static

# Swagger UI — set to "false" to disable
ENABLE_DOCS=true

# Number of taps/clicks to delete a box (requires restart)
DELETE_TAP_COUNT=3

# Move Add/Manage controls to a dedicated tab instead of the toolbar.
# Set to "true" for touch-only display devices (tablets, small screens).
SEPARATE_ADD_TAB=false

# Custom colors offered when creating boxes.
# Each entry is "#rrggbb,#rrggbb" (background, text color). Index any number
# 1..32; unset indices are skipped. If none are set, the built-in 8-color
# dark palette is used. Existing boxes keep their colors regardless.
#BOX_COLOR_1=#422006,#fde68a
#BOX_COLOR_2=#052e16,#86efac
#BOX_COLOR_3=#0f1e40,#93c5fd
#BOX_COLOR_4=#3d0a22,#f9a8d4
#BOX_COLOR_5=#3d1604,#fdba74
#BOX_COLOR_6=#200d40,#c4b5fd
#BOX_COLOR_7=#042420,#5eead4
#BOX_COLOR_8=#1e2530,#cbd5e1

# Default canvas dimensions for new box placement (pixels)
DEFAULT_CANVAS_WIDTH=1280
DEFAULT_CANVAS_HEIGHT=800

# Log level
RUST_LOG=info
